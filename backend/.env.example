# 로컬 PostgreSQL 접속 설정 예시
# 호스트, 포트, DB 이름, 사용자 기본값
DB_HOST=localhost
DB_PORT=5432
DB_NAME=shortsflow
DB_USER=shortsflow_user
# 실제 비밀번호는 backend/.env에 입력
DB_PASSWORD=

# 10단계 GPT 콘텐츠 분석 설정
ANALYSIS_MOCK_MODE=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# n8n Production Webhook URL
N8N_WEBHOOK_URL=http://127.0.0.1:5678/webhook/shortsflow
